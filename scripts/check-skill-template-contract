#!/usr/bin/env bash
# loom: skill section contract canary
# Exit: 0 clean, 1 drift detected
set -euo pipefail

ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
SKILLS_DIR="$ROOT/skills"
errors=()

legacy_sections=(
  "## Goal"
  "## Inputs"
  "## Outputs"
  "## Process"
  "## Hard stops"
  "## Failure modes"
  "## Done when"
)

executable_sections=(
  "## Trigger"
  "## Inputs"
  "## Decision and effect"
  "## Local signal map"
  "## Hard stops"
  "## Next action"
)

validate_executable_contract() {
  local name="$1" contract="$2" section exact_count shadow_count decision_section signal_map

  for section in "${executable_sections[@]}"; do
    exact_count=$(grep -Ec "^${section}[[:space:]]*$" "$contract" || true)
    shadow_count=$(grep -Ec "^${section}([[:space:]]|$)" "$contract" || true)
    if (( exact_count != 1 || shadow_count != 1 )); then
      errors+=("$name: must contain exactly one canonical '$section' section and no duplicate or shadow section")
    fi
  done

  decision_section="$(awk '/^## Decision and effect[[:space:]]*$/{inside=1; next} inside && /^## /{exit} inside{print}' "$contract")"
  if ! grep -Eq '^[0-9]+\.[[:space:]]+[^[:space:]]' <<<"$decision_section"; then
    errors+=("$name: decision and effect must contain numbered executable actions")
  fi
  if awk '
    /^## Decision and effect[[:space:]]*$/ { inside=1; next }
    inside && /^## / { inside=0 }
    !inside && /^[0-9]+\.[[:space:]]+[^[:space:]]/ { found=1 }
    END { exit !found }
  ' "$contract"; then
    errors+=("$name: numbered executable actions must appear only in Decision and effect")
  fi

  signal_map="$(awk '/^## Local signal map[[:space:]]*$/{inside=1; next} inside && /^## /{exit} inside{print}' "$contract")"
  if ! grep -Eq '^\|[[:space:]]*Signal[[:space:]]*\|[[:space:]]*Reference[[:space:]]*\|[[:space:]]*Use[[:space:]]*\|[[:space:]]*$' <<<"$signal_map"; then
    errors+=("$name: local signal map must declare Signal, Reference, and Use columns")
    return
  fi

  local row_count=0 signal reference use malformed links valid_reference target local_target
  while IFS=$'\t' read -r signal reference use malformed; do
    [ -n "$signal$reference$use$malformed" ] || continue
    row_count=$((row_count + 1))
    if [ "$malformed" = "malformed" ] || [ -z "$signal" ] || [ -z "$reference" ] || [ -z "$use" ]; then
      errors+=("$name: local signal map row $row_count must contain exactly Signal, Reference, and Use cells")
      continue
    fi
    if ! grep -Eqi '^(required|advisory)([[:space:];,:.-]|$)' <<<"$use" || grep -Eqi '(^|[^[:alpha:]])(required.*advisory|advisory.*required)([^[:alpha:]]|$)' <<<"$use"; then
      errors+=("$name: local signal map row $row_count Use must classify exactly one of required or advisory")
    fi
    links="$(grep -Eo '\[[^]]+\]\([^)]+\)' <<<"$reference" || true)"
    if [ -z "$links" ]; then
      errors+=("$name: local signal map row $row_count Reference must contain a Markdown local link or explicit external link")
      continue
    fi
    valid_reference=false
    while IFS= read -r target; do
      [ -n "$target" ] || continue
      case "$target" in
        http://*|https://*)
          if grep -Eqi 'external|repository|host-native|live guidance' <<<"$reference"; then valid_reference=true; fi
          ;;
        mailto:*|\#*) ;;
        *)
          local_target="$(cd "$(dirname "$contract")" && pwd)/$target"
          if [ -e "$local_target" ]; then
            valid_reference=true
          else
            errors+=("$name: local signal map row $row_count references missing local target '$target'")
          fi
          ;;
      esac
    done < <(awk -F'[()]' '{print $2}' <<<"$links")
    if [ "$valid_reference" != true ]; then
      errors+=("$name: local signal map row $row_count Reference has no resolving local link or clearly labeled external link")
    fi
  done < <(awk -F'|' '
    /^\|[[:space:]]*Signal[[:space:]]*\|/ { next }
    /^\|[[:space:]]*:?-{3,}/ { next }
    /^\|/ {
      if (NF != 5) { print "\t\t\tmalformed"; next }
      signal=$2; reference=$3; use=$4
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", signal)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", reference)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", use)
      print signal "\t" reference "\t" use "\t"
    }
  ' <<<"$signal_map")
  if (( row_count == 0 )); then errors+=("$name: local signal map must contain at least one data row"); fi
}

validate_dispatcher_contract() {
  local name="$1" contract="$2" section exact_count shadow_count table rows actual expected
  local sections=("## Trigger" "## Inputs" "## Decision contract" "## Route output" "## Local reference map" "## Hard stops" "## Next action")
  for section in "${sections[@]}"; do
    exact_count=$(grep -Ec "^${section}[[:space:]]*$" "$contract" || true)
    shadow_count=$(grep -Ec "^${section}([[:space:]]|$)" "$contract" || true)
    if (( exact_count != 1 || shadow_count != 1 )); then
      errors+=("$name: must contain exactly one canonical '$section' section and no duplicate or shadow section")
    fi
  done

  if [ "$(grep -Ec '^<!-- loom:dispatcher-decisions -->$' "$contract" || true)" -ne 1 ] || [ "$(grep -Ec '^<!-- loom:dispatcher-decisions:end -->$' "$contract" || true)" -ne 1 ]; then
    errors+=("$name: must contain exactly one dispatcher decision table")
    return
  fi
  table="$(awk '/^<!-- loom:dispatcher-decisions -->$/{inside=1;next}/^<!-- loom:dispatcher-decisions:end -->$/{inside=0;exit}inside{print}' "$contract")"
  if ! grep -Eq '^\| Precedence \| Condition \| Observable condition \| Action \|$' <<<"$table"; then
    errors+=("$name: dispatcher decision table must declare Precedence, Condition, Observable condition, and Action")
    return
  fi
  actual="$(awk -F'|' '/^\| [0-9]+ /{for(i=2;i<=5;i++){gsub(/^[[:space:]]+|[[:space:]]+$/,"",$i)}; print $2 "|" $3 "|" $5}' <<<"$table")"
  expected=$'10|`STOP(missing-authority,stale-authority,contradictory-authority,excessive-authority,unattributed-authority,authority-narrower-than-intent,version-incompatible,unavailable-evidence,conflict,blocker,reconciliation,ambiguous-intent)`|STOP\n20|`ROUTE(setup)`|Setup\n30|`ROUTE(grill)`|Grill\n40|`ROUTE(plan)`|Plan\n50|`ROUTE(implement)`|Implement\n60|`ROUTE(verify)`|Verify\n70|`ROUTE(finish)`|Finish\n80|`ROUTE(publish)`|Publish\n90|`NONE(no-work)`|NONE'
  if [ "$actual" != "$expected" ]; then
    errors+=("$name: dispatcher decision table must contain the unique closed ordered actions with STOP first and NONE last")
  fi
  rows="$(grep -Ec '^\| [0-9]+ ' <<<"$table" || true)"
  if [ "$rows" -ne 9 ]; then errors+=("$name: dispatcher decision table must contain exactly nine decisions"); fi
  if ! grep -Eq 'Return exactly one table action and stop' "$contract"; then errors+=("$name: dispatcher must require exactly one result and stop"); fi
  if ! grep -Eq 'dispatcher reads it and never writes it' "$contract" || ! grep -Eq 'pointer write, route artifact' "$contract"; then
    errors+=("$name: recovery pointer must be read-only and must not persist route state")
  fi
}

for skill_dir in "$SKILLS_DIR"/*/; do
  [ -f "${skill_dir}SKILL.md" ] || continue
  name="$(basename "$skill_dir")"
  skill="${skill_dir}SKILL.md"

  case "$name" in
    loom-plan|loom-implement|loom-verify) validate_executable_contract "$name" "$skill" ;;
    loom) validate_dispatcher_contract "$name" "$skill" ;;
    *)
      for section in "${legacy_sections[@]}"; do
        if ! grep -q "^${section}" "$skill"; then
          errors+=("$name: missing required section '$section'")
        fi
      done
      ;;
  esac

  if ! grep -q '^disable-model-invocation:' "$skill" 2>/dev/null; then
    if [ "$name" != "loom-verify" ]; then
      errors+=("$name: ritual skill should declare disable-model-invocation in frontmatter")
    fi
  fi
done

validate_executable_contract "loom/FINISH.md" "$SKILLS_DIR/loom/FINISH.md"
validate_executable_contract "loom/PUBLISH.md" "$SKILLS_DIR/loom/PUBLISH.md"

if [ ${#errors[@]} -eq 0 ]; then
  echo '{"status":"clean","message":"Skill template contract checks passed"}'
  exit 0
fi

echo "{"
echo '  "status": "drift",'
echo '  "errors": ['
for i in "${!errors[@]}"; do
  comma=","
  [ "$i" -eq "$((${#errors[@]} - 1))" ] && comma=""
  echo "    \"${errors[$i]}\"$comma"
done
echo '  ]'
echo "}"
exit 1
