#!/usr/bin/env bash
# loom: drift canary — checks skills/ vs AGENTS.md managed block consistency
# Exit: 0 clean, 1 drift detected
set -euo pipefail

ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
AGENTS="$ROOT/AGENTS.md"
SKILLS_DIR="$ROOT/skills"
errors=()

if [ ! -f "$AGENTS" ]; then
  echo '{"status":"skip","message":"No AGENTS.md found"}'
  exit 0
fi

# Extract version from managed block
block_version=$(grep -o 'loom:begin version=[^ ]*' "$AGENTS" 2>/dev/null | head -1 | sed 's/loom:begin version=//')
pkg_version=$(grep '"version"' "$ROOT/package.json" 2>/dev/null | head -1 | sed 's/.*: *"//' | sed 's/".*//')

if [ -n "$block_version" ] && [ -n "$pkg_version" ]; then
  # Strip leading v for comparison
  bv="${block_version#v}"
  if [ "$bv" != "$pkg_version" ]; then
    errors+=("version mismatch: AGENTS.md=$block_version vs package.json=$pkg_version")
  fi
fi

# Check adapter versions match package.json
for adapter in "$ROOT/.claude-plugin/plugin.json" "$ROOT/.codex-plugin/plugin.json"; do
  [ -f "$adapter" ] || continue
  av=$(grep '"version"' "$adapter" 2>/dev/null | head -1 | sed 's/.*: *"//' | sed 's/".*//')
  if [ -n "$av" ] && [ -n "$pkg_version" ] && [ "$av" != "$pkg_version" ]; then
    errors+=("version mismatch: $(basename "$(dirname "$adapter")")/plugin.json=$av vs package.json=$pkg_version")
  fi
done

opencode="$ROOT/opencode-plugin.mjs"
if [ -f "$opencode" ] && [ -n "$pkg_version" ]; then
  ov=$(grep -o 'Version: [0-9.]*' "$opencode" 2>/dev/null | grep -o '[0-9][0-9.]*' | head -1)
  if [ -n "$ov" ] && [ "$ov" != "$pkg_version" ]; then
    errors+=("version mismatch: opencode-plugin.mjs=$ov vs package.json=$pkg_version")
  fi
fi

# Check all skills referenced in AGENTS.md router exist
for skill in loom-init loom-plan loom-grill loom-implement loom-verify; do
  if [ ! -f "$SKILLS_DIR/$skill/SKILL.md" ]; then
    errors+=("router references $skill but skills/$skill/SKILL.md missing")
  fi
done

# The compact managed block points to the dispatcher; the dispatcher owns skill routing.
if ! grep -Fq 'skills/loom/SKILL.md' "$AGENTS" 2>/dev/null; then
  errors+=("AGENTS.md must point to skills/loom/SKILL.md")
fi
for skill_dir in "$SKILLS_DIR"/*/; do
  [ -d "$skill_dir" ] || continue
  skill_name=$(basename "$skill_dir")
  [ "$skill_name" = "loom" ] && continue
  if ! grep -q "$skill_name" "$SKILLS_DIR/loom/SKILL.md" 2>/dev/null; then
    errors+=("skills/$skill_name exists but not mentioned in dispatcher")
  fi
done

# Checker manifests exist in two dialects (agents/ = OMP-style, .claude-plugin/agents/ = Claude-style).
# Frontmatter legitimately differs (model tier names, tool names); the prompt BODY must not drift.
for m in "$ROOT"/agents/*.md; do
  [ -f "$m" ] || continue
  cc="$ROOT/.claude-plugin/agents/$(basename "$m")"
  if [ ! -f "$cc" ]; then
    errors+=("$(basename "$m") has no .claude-plugin/agents/ counterpart")
    continue
  fi
  if ! node -e '
    const fs = require("fs");
    const body = (p) => fs.readFileSync(p, "utf8")
      .replace(/^---[\s\S]*?\n---\n/, "")
      .replace(/^Reply with a structured verdict[^\n]*$/m, "")
      // dialect-specific yield/return contract lines (OMP yields, Claude replies)
      .replace(/^- \*\*Yield contract:\*\*[^\n]*$/m, "")
      .replace(/\n{2,}/g, "\n").trim();
    process.exit(body(process.argv[1]) === body(process.argv[2]) ? 0 : 1);
  ' "$m" "$cc"; then
    errors+=("checker manifest body drift: agents/$(basename "$m") vs .claude-plugin/agents/$(basename "$m")")
  fi
done

if [ ${#errors[@]} -eq 0 ]; then
  echo '{"status":"clean","message":"No drift detected"}'
  exit 0
fi

echo "{"
echo "  \"status\": \"drift\","
echo "  \"errors\": ["
for i in "${!errors[@]}"; do
  comma=","
  [ $i -eq $((${#errors[@]} - 1)) ] && comma=""
  echo "    \"${errors[$i]}\"$comma"
done
echo "  ]"
echo "}"
exit 1
