#!/usr/bin/env bash
# loom: keep instruction surfaces from growing silently; raise the budget with evidence after review.
set -euo pipefail

ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$ROOT"

check() {
  local path="$1" max="$2" actual
  actual=$(wc -c < "$path" | tr -d ' ')
  printf '%7d / %-7d %s\n' "$actual" "$max" "$path"
  if (( actual > max )); then
    printf 'budget exceeded: %s is %d bytes over its %d-byte budget\n' "$path" "$((actual - max))" "$max" >&2
    return 1
  fi
}

printf '%s\n' 'Loom instruction-surface budget (bytes)' 'actual / budget path'

# Budgets are measured current baselines with about 10% headroom, not permission to grow.
check AGENTS.md 2100
check commands/loom.md 600
check skills/loom/SKILL.md 5050
check skills/loom/CONSTITUTION.md 3700
check skills/loom/AUTHORITY.md 6350
check skills/loom/SESSION.md 2100
check skills/loom/STORY.md 14700
check skills/loom/ORCA.md 6250
check skills/loom/ORCA-DISPATCH.md 7950
check skills/loom/ORCA-RESUME.md 5500
check skills/loom/ORCA-CLEANUP.md 2850
check skills/loom/WORKER-BRIEFING.md 5500
check skills/loom/OMP.md 6500

check skills/loom-grill/SKILL.md 12550
check skills/loom-grill/INTERVIEW.md 14700
check skills/loom-grill/RESEARCH.md 4250
check skills/loom-grill/DECISION-FRONTIER.md 3250
check skills/loom-plan/SKILL.md 6800
check skills/loom-plan/GRILL.md 2100
check skills/loom-implement/SKILL.md 7050
check skills/loom-verify/SKILL.md 8050
check skills/loom-verify/TICKET-RECORD.md 4450
check skills/loom/FINISH.md 8150
check skills/loom/PUBLISH.md 7400

printf '%s\n' '{"status":"pass","message":"Instruction-surface budgets passed"}'
