#!/usr/bin/env bash
# loom: keep instruction surfaces from growing silently; raise the budget with evidence after review.
set -euo pipefail

ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$ROOT"

check() {
  local path="$1" max="$2" actual
  actual=$(wc -c < "$path" | tr -d ' ')
  printf '%7d / %-7d %s\n' "$actual" "$max" "$path"
  if (( actual > max )); then
    printf 'budget exceeded: %s is %d bytes over its %d-byte budget\n' "$path" "$((actual - max))" "$max" >&2
    return 1
  fi
}

printf '%s\n' 'Loom instruction-surface budget (bytes)' 'actual / budget path'

# Budgets are measured current baselines with about 10% headroom, not permission to grow.
check AGENTS.md 2100
check commands/loom.md 600
check skills/loom/SKILL.md 5800
check skills/loom/CONSTITUTION.md 3500
check skills/loom/AUTHORITY.md 7900
check skills/loom/SESSION.md 2000

check skills/loom-grill/SKILL.md 12900
check skills/loom-plan/SKILL.md 6200
check skills/loom-plan/GRILL.md 20000
check skills/loom-implement/SKILL.md 6405
check skills/loom-verify/SKILL.md 7900
check skills/loom-verify/TICKET-RECORD.md 4300
check skills/loom/FINISH.md 8600
check skills/loom/PUBLISH.md 7900

printf '%s\n' '{"status":"pass","message":"Instruction-surface budgets passed"}'
